# Public site URL, no trailing slash. Used for auth redirects, share links, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated sport ids, or `all`. Unknown ids are ignored. Unset defaults to every sport.
# NBA only (hides the filter bar): nba
ENABLED_SPORTS=all

# Stripe. Leave as placeholders until you want Pro checkout. Webhook signing secret is server-only.
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
STRIPE_PRICE_MONTHLY=replace_me
STRIPE_PRICE_YEARLY=replace_me

# Used when more than one sport is enabled. Must be one of ENABLED_SPORTS. Falls back to the first enabled sport.
DEFAULT_SPORT=nba

# Puzzle #1 is this calendar date, evaluated in US Eastern time. Format YYYY-MM-DD.
LAUNCH_DATE=2026-01-01

# When true, the daily selector uses only athletes marked verified. Seed data ships unverified, so leave false until you flip flags.
REQUIRE_VERIFIED=false

# HMAC secret for guess-state tokens. Required in production. Use a long random string.
GAME_SECRET=replace-with-a-long-random-string

# Supabase (Project Settings → API). Anon key is public. Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
